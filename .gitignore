# Ignore generated output and local tooling only.
# Source, configuration, tests, and project documentation remain eligible for Git.
# Keep schematic documents (Markdown, PDF, SVG, PNG, and TeX) eligible as well;
# save maintained documents under docs/, outside ignored output directories.
# New documents and code changes are included with git add, not ignore entries.

# PlatformIO: .pio/core cache, .pio/p packages, .pio/tools compilers,
# .pio/build firmware/native tests, and verification logs.
.pio/
platformio.local.ini

# Firmware exported to the project root (including MERGED_BIN_PATH overrides).
# Keep arbitrary binary fixtures elsewhere eligible for version control.
/firmware.bin
/firmware-merged.bin
/*-merged.bin

# Local Python environments and generated bytecode.
.venv/
venv/
__pycache__/
*.py[cod]

# Verification logs if commands are redirected into the project root.
/build-validation.log
/test-validation.log
/verification.log
/verification-paths.log
/fall-timing-verify.log
# Baseline, focused fault tests, and expanded verification runs.
/baseline-verification.log
/fault-tests.log
/expanded-verification.log

# Editor and language-server state.
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch/
.vscode/settings.json
.vscode/extensions.json
.idea/
cmake-*
.cache
.ccls
compile_commands.json

# Other local output and operating-system metadata.
out/
.direnv/
.DS_Store
Thumbs.db
Desktop.ini
